<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/queue_running_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/activity_margin"
    android:orientation="vertical"
    android:padding="@dimen/activity_margin">

    <TextView
        android:id="@+id/queue_running_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="middle"
        android:singleLine="true"
        android:textSize="17sp"
        android:textStyle="bold"
        tools:text="video.mp4" />

    <TextView
        android:id="@+id/queue_running_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/small_margin"
        tools:text="Comprimindo · 42%" />

    <ProgressBar
        android:id="@+id/queue_running_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/small_margin"
        android:max="100" />

    <TextView
        android:id="@+id/queue_running_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/small_margin"
        android:textSize="13sp"
        tools:text="Original: 120 MB · estimativa ≈ 40 MB" />

    <TextView
        android:id="@+id/queue_running_cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:background="?attr/selectableItemBackground"
        android:padding="@dimen/medium_margin"
        android:text="@string/cmp_q_cancel_current"
        android:textAllCaps="true"
        android:textStyle="bold" />

</LinearLayout>
