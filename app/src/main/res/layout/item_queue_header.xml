<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/activity_margin"
    android:paddingTop="@dimen/medium_margin"
    android:paddingEnd="@dimen/activity_margin"
    android:paddingBottom="@dimen/medium_margin">

    <TextView
        android:id="@+id/queue_header_eta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="Restante: ≈ 12 min (3 itens)" />

    <TextView
        android:id="@+id/queue_header_run_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/medium_margin"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="Última execução" />

    <TextView
        android:id="@+id/queue_header_run_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        tools:text="5 concluído(s) · 1 falha(s) · 0 descartado(s) · 0 cancelado(s)" />

    <TextView
        android:id="@+id/queue_header_run_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        tools:text="Espaço economizado: 1,2 GB · terminou em 14:32" />

</LinearLayout>
