<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/queue_item_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/activity_margin"
    android:paddingTop="@dimen/medium_margin"
    android:paddingBottom="@dimen/medium_margin">

    <ImageView
        android:id="@+id/queue_item_drag"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:layout_marginStart="-12dp"
        android:contentDescription="@string/cmp_q_drag"
        android:paddingStart="4dp"
        android:paddingEnd="12dp"
        android:src="@drawable/ic_drag_handle_vector"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/queue_item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textStyle="bold"
            tools:text="video.mp4" />

        <TextView
            android:id="@+id/queue_item_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            tools:text="Concluído" />

        <TextView
            android:id="@+id/queue_item_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Antes: 120 MB · Depois: 40 MB (−67%)" />
    </LinearLayout>

    <ImageView
        android:id="@+id/queue_item_menu"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@null"
        android:padding="12dp"
        android:src="@drawable/ic_queue_more_vector" />

</LinearLayout>
